.farmer-app {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
  padding: 20px 18px 100px;
  min-height: 100vh;
  background: #f4f8f0;
  color: #16351f;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-symbol {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: #198443;
  display: grid;
  place-items: center;
  color: white;
  font-size: 24px;
  font-weight: 900;
}

.logo-text {
  font-size: 22px;
  font-weight: 900;
}

.connection {
  width: 50px;
  height: 50px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23px;
}

.connected {
  color: #16833e;
  background: #d8f5df;
}

.disconnected {
  color: #777;
  background: #e7e7e7;
}

.connection-dot {
  display: none;
}

.main-status {
  background: #198443;
  color: white;
  border-radius: 28px;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  min-height: 120px;
  margin-bottom: 24px;
}

.big-status {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 42px;
  background: rgba(255,255,255,.2);
}

.main-status-text h1 {
  font-size: 38px;
  margin: 0;
}

.main-status-text p {
  margin: 0;
}

.sensors {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.sensor-card {
  background: #fff;
  border: 3px solid #e5eae2;
  border-radius: 28px;
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 230px;
  transition: border-color .2s;
}

.sensor-card.green {
  border-color: #b9e8c6;
}

.sensor-card.yellow {
  border-color: #f4d66e;
}

.sensor-card.red {
  border-color: #f1a3a3;
}

.sensor-card.gray {
  border-color: #e5eae2;
}

.sensor-symbol {
  font-size: clamp(48px, 8vw, 72px);
  line-height: 1.3;
  margin-bottom: 8px;
}

.sensor-value {
  font-size: clamp(28px, 5vw, 40px);
  font-weight: 900;
  color: #173c23;
  text-align: center;
  word-break: break-word;
}

.sensor-value small {
  font-size: 17px;
  font-weight: 700;
  margin-left: 5px;
}

.meter {
  width: 100%;
  height: 16px;
  background: #e9eee7;
  border-radius: 50px;
  overflow: hidden;
  margin-top: 18px;
}

.meter-fill {
  height: 100%;
  border-radius: 50px;
  transition: width .5s ease;
}

.meter-fill.green {
  background: #21a354;
}

.meter-fill.yellow {
  background: #e8b82c;
}

.meter-fill.red {
  background: #dc4545;
}

.meter-fill.gray {
  background: #aaa;
}

.status-symbol {
  margin-top: 14px;
}

.status-circle,
.legend-circle {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-size: 23px;
  font-weight: 900;
}

.status-circle.green,
.legend-circle.green {
  background: #d8f5df;
  color: #15803d;
}

.status-circle.yellow,
.legend-circle.yellow {
  background: #fff1bf;
  color: #9b6c00;
}

.status-circle.red,
.legend-circle.red {
  background: #ffe0e0;
  color: #b42323;
}

.status-circle.gray,
.legend-circle.gray {
  background: #e5e7eb;
  color: #555;
}

.sensor-name {
  display: none;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 28px;
  padding: 30px 0 15px;
}

.legend-item {
  display: flex;
  align-items: center;
}

.navigation {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 900px;
  margin: 0 auto;
  background: #fff;
  border-top: 1px solid #e6e9e4;
  padding: 12px 16px;
  display: flex;
  justify-content: space-around;
  z-index: 10;
}

.nav-button {
  border: 0;
  background: transparent;
  width: 65px;
  height: 60px;
  border-radius: 18px;
  font-size: 30px;
  display: grid;
  place-items: center;
  color: #617265;
}

.nav-button.active {
  background: #d9f3df;
  color: #198443;
}

@media (min-width: 650px) {
  .sensors {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sensor-card {
    min-height: 250px;
  }

  .farmer-app {
    padding-top: 30px;
  }
}

@media (max-width: 380px) {
  .farmer-app {
    padding: 14px 10px 90px;
  }

  .sensors {
    gap: 10px;
  }

  .sensor-card {
    padding: 18px 12px;
    min-height: 210px;
  }
}
